{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/trade", "destination": "/trade/index.html" },
    { "source": "/trade/options", "destination": "/trade/options/index.html" },
    { "source": "/portfolio", "destination": "/portfolio/index.html" },
    { "source": "/list-token", "destination": "/list-token/index.html" }
  ]
}
